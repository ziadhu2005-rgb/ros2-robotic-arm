<?xml version="1.0"?>
<robot name="arm">

  <!-- Colors -->
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>

  <!-- world link + fixed joint bolts the base to the ground in Gazebo -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========== BASE (8 cm tall box) ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.10 0.10 0.08"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.10 0.10 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000683" ixy="0" ixz="0" iyy="0.000683" iyz="0" izz="0.000833"/>
    </inertial>
  </link>

  <!-- joint1 - base rotation, on top of the base, turns around z -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="L1"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <!-- ========== L1 (12 cm) ========== -->
  <link name="L1">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.12"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.000126" ixy="0" ixz="0" iyy="0.000126" iyz="0" izz="0.0000113"/>
    </inertial>
  </link>

  <!-- joint2 - shoulder, at the top of L1, bends around y -->
  <joint name="joint2" type="revolute">
    <parent link="L1"/>
    <child link="L2"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- ========== L2 (15 cm) ========== -->
  <link name="L2">
    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.15"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.15"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.000232" ixy="0" ixz="0" iyy="0.000232" iyz="0" izz="0.0000135"/>
    </inertial>
  </link>

  <!-- joint3 - elbow, at the end of L2, bends around y -->
  <joint name="joint3" type="revolute">
    <parent link="L2"/>
    <child link="L3"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- ========== L3 (9 cm) ========== -->
  <link name="L3">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.09"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.09"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.07"/>
      <inertia ixx="0.0000498" ixy="0" ixz="0" iyy="0.0000498" iyz="0" izz="0.00000504"/>
    </inertial>
  </link>

  <!-- joint4 - wrist, at the end of L3, bends around y -->
  <joint name="joint4" type="revolute">
    <parent link="L3"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- ========== END EFFECTOR (6 cm gripper) ========== -->
  <link name="end_effector">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.02 0.04 0.06"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.02 0.04 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000217" ixy="0" ixz="0" iyy="0.0000167" iyz="0" izz="0.00000833"/>
    </inertial>
  </link>

  <!-- ========== GAZEBO PLUGINS ========== -->
  <!-- Publishes the simulated joint angles (bridged to /joint_states) -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/arm/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- One position controller per joint, each listening on /arm/jointN/cmd_pos -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <topic>/arm/joint1/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>3</cmd_max>
      <cmd_min>-3</cmd_min>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint2</joint_name>
      <topic>/arm/joint2/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>3</cmd_max>
      <cmd_min>-3</cmd_min>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint3</joint_name>
      <topic>/arm/joint3/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>3</cmd_max>
      <cmd_min>-3</cmd_min>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint4</joint_name>
      <topic>/arm/joint4/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>3</cmd_max>
      <cmd_min>-3</cmd_min>
    </plugin>
  </gazebo>

</robot>
